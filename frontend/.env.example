# Public frontend configuration. Never put secrets in NEXT_PUBLIC_* variables.
# Current verified production frontend origin. Change only after domain purchase,
# DNS configuration and HTTPS verification.
NEXT_PUBLIC_SITE_URL=https://schemeknit-frontend.onrender.com
# Set true only on the isolated staging deployment. Emits noindex protections.
NEXT_PUBLIC_STAGING=false
# Backend API origin for the matching environment.
NEXT_PUBLIC_API_URL=https://schemeknit-api.onrender.com
