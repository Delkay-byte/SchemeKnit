INSERT INTO lesson_plans (id, job_id, owner_id, scheme_id, school_id, week_number, week_ending, week_ending_derived, teaching_week, carry_forward, lesson_sequence, lesson_date, lesson_number, period, class_level, subject, class_size, duration_minutes, school_name, teacher_name, strand, sub_strand, content_standard, content_standard_code, indicators, indicator_codes, lesson_topic, previous_knowledge, learning_objectives, wapef_deep_hope, wapef_storyline, wapef_through_lines, wapef_gods_story, remarks, core_competencies, source_tlrs, other_tlrs, teaching_learning_resources, introduction, starter_activity, main_activities, learner_activities, teacher_activities, assessment, conclusion, "references", structured_references, keywords, homework, class_assignment, home_assignment, differentiation, essential_questions, template_id, special_period_label, special_period_type, status, ai_generated, teacher_edited, original_data, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
2026-09-29 10:50:15,057 INFO sqlalchemy.engine.Engine [cached since 0.01701s ago] ('55d34c4b-45a8-494f-806d-a8608327518d', 'e6856d3b-b8e0-4e0b-a3d3-826b635a1f2a', '548ec0e8-d758-4c82-a12c-b251e7bc90c6', '460b4bd7-ed52-4935-9910-e5fc101764be', None, 3, '2026-09-25', 0, 3, 0, 3, '2026-09-21', 1, '', 'Basic 7', 'ICT', 11, 60, 'Achimota Basic School', 'Persistence Teacher', 'Introduction to Computing', 'Components of Computers and Computer Systems', 'B7.1.1.1', 'B7.1.1.1', '["B7.1.1.1.4"]', '["B7.1.1.1.4"]', 'Hard drives and optical storage media', 'Previous lesson: Components of Computers and Computer Systems', '[{"id": "bfde7d86-17c4-4f90-bf8d-b17a3b491d0c", "description": "Learners can identify hard drives and optical storage media", "indicator_code": "B7.1.1.1.4", "source": "deterministic"}]', '', '', '[]', '', '', '[]', '["Hard Disk", "Pen drive"]', '[]', '["Hard Disk", "Pen drive"]', "This lesson builds on 'Components of Computers and Computer Systems' and moves the class on to Hard drives and optical storage media.", "Build on the previous lesson ('Components of Computers and Computer Systems'). Display a portable hard drive and two optical discs (one CD, one DVD). Ask learners where they save school work and why, and note their answers on the board.", '[{"id": "3c6acad1-1fda-405a-b2b4-45ac0b36981d", "phase": "TEACHING AND DEMONSTRATION", "description": "Name and point to each storage item: magnetic  ... (714 characters truncated) ...  the board or an unplugged model if there are not enough devices for everyone.", "duration_minutes": 12, "resources": [], "source": "deterministic"}]', '[{"id": "0348c8e8-7ff4-4839-b02a-60774f54e7b7", "phase": "LEARNER", "description": "Watch and listen carefully, then describe each step of Hard drive ... (507 characters truncated) ... describe each step of Hard drives and optical storage media in your own words.", "duration_minutes": 12, "resources": [], "source": "deterministic"}]', '[{"id": "fea5f50f-0d5b-4535-99a0-595529f39c0a", "phase": "TEACHER", "description": "Model Hard drives and optical storage media slowly, think aloud,  ... (512 characters truncated) ... orage media slowly, think aloud, and check that all learners can see and hear.", "duration_minutes": 12, "resources": [], "source": "deterministic"}]', 'Ask each group to name the storage item with the largest capacity on the table and give the evidence from the label. Check that learners can say why an optical disc is read-only while a hard drive can be written many times. Assessment mode: Oral questions and observation of participation.', "Review the steps for Hard drives and optical storage media, discuss the common problem met and how it was solved, and link to everyday technology. Preview the next lesson ('Components of Computers and Computer Systems').", '[]', '[]', '[]', 'Find one storage device at home or school. Write the capacity printed on it, whether it is magnetic or optical, and one advantage of that type of storage.', 'Groups build a comparison table of the hard drive, portable hard drive, CD-ROM and DVD-ROM using the printed capacities and write speeds, then state one strength and one weakness of each. The teacher checks each table has the correct units.', 'Find one storage device at home or school. Write the capacity printed on it, whether it is magnetic or optical, and one advantage of that type of storage.', "Support: Pair learners who need help with a peer 'digital buddy' and provide a numbered step card for Hard drives and optical storage media.\nExtensi ... (56 characters truncated) ... rd drives and optical storage media to a slightly harder task.\nGrouping: Whole-class demonstration, small groups at shared devices, individual task.", '[]', 'tpl-wapef-approved-plan', '', '', 'generated', 0, 0, '{}', '2026-09-29 10:50:15.057738', '2026-09-29 10:50:15.057741')
