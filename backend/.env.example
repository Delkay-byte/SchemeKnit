# ═══════════════════════════════════════════════════════════════════════
# SchemeKnit — Production Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in real values.
# NEVER commit the .env file with real secrets.
# The application refuses to start in production mode (DEBUG=false)
# when critical values are missing or unsafe (see config.py).
#
# ── DEVELOPMENT vs PRODUCTION ───────────────────────────────────────────
# DEBUG=true  → dev defaults allowed, localhost URLs OK, docs enabled
# DEBUG=false → production: all critical secrets verified at startup

# ── CORE ────────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=SchemeKnit
APP_VERSION=1.0.4

# Secret key for session signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<generate-a-real-secret>

# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-real-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── DATABASE ────────────────────────────────────────────────────────────
# Production: managed PostgreSQL. SQLite is for development/desktop only.
DATABASE_URL=postgresql://user:password@host:5432/schemeknit

# Tests must NEVER touch the production database.
TEST_DATABASE_URL=postgresql://user:password@host:5432/schemeknit_test

# GENERATION LIVENESS / CRASH RECOVERY
# A non-terminal generation job is reclaimed as failed only when its last
# activity (worker heartbeat, else created_at for legacy rows) is strictly
# older than GENERATION_STALE_MINUTES. Units: integer minutes. Default: 60.
# GENERATION_HEARTBEAT_SECONDS is how often a running worker refreshes that
# timestamp; it must be shorter than the stale window. Units: seconds.
# Default: 30. Invalid values (<= 0, > 24 hours stale, heartbeat >= window)
# fail at startup instead of silently reclaiming live work.
GENERATION_STALE_MINUTES=60
GENERATION_HEARTBEAT_SECONDS=30

# ── PUBLIC URLs (no localhost in production) ────────────────────────────
# The frontend's public URL (Next.js).
PUBLIC_WEB_URL=https://app.schemeknit.com
# The backend API's public URL (FastAPI).
API_BASE_URL=https://api.schemeknit.com

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No localhost in production.
CORS_ORIGINS=https://app.schemeknit.com,https://schemeknit.com

# ── PLATFORM ADMIN BOOTSTRAP ────────────────────────────────────────────
# One-time secret to create the FIRST platform admin at
# /setup/platform-admin. Set a strong value, deploy, create the admin,
# then remove or rotate it. Empty = bootstrap disabled (CLI tool only).
PLATFORM_ADMIN_BOOTSTRAP_SECRET=<set-a-strong-secret>

PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Progressive failed-login cooldown and shared rate limiting
SECURITY_HMAC_KEY=
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_STEPS=1,5,15,30,60
LOGIN_LOCKOUT_TRACK_HOURS=24
RATE_LIMIT_BACKEND=db
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
ENABLE_HSTS=false
CSP_REPORT_ONLY=true
# Optional central security-alert webhook. Empty keeps structured-log-only mode.
SECURITY_ALERT_WEBHOOK_URL=

# ── FILE STORAGE ────────────────────────────────────────────────────────
# local = filesystem (development / single-server)
# s3   = S3-compatible object storage (production)
STORAGE_BACKEND=s3

# Only used when STORAGE_BACKEND=local:
# TEACHFLOW_DATA_DIR=/var/schemeknit/data

# Only used when STORAGE_BACKEND=s3 (AWS S3, MinIO, Cloudflare R2,
# Backblaze B2, DigitalOcean Spaces, …):
S3_ENDPOINT=
S3_REGION=us-east-003
S3_BUCKET=schemeknit-production
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>

# ── TRANSACTIONAL EMAIL (Resend) ────────────────────────────────────────
# Server-side ONLY. NEVER expose to browser code.
# Do NOT use NEXT_PUBLIC_RESEND_API_KEY.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sending domain must be verified in Resend. Do NOT use resend.dev.
# Use a subdomain of your production domain, e.g. mail.schemeknit.com
EMAIL_FROM=notify@schemeknit.com
EMAIL_REPLY_TO=support@schemeknit.com

# ── AI PROVIDER ─────────────────────────────────────────────────────────
# Zeli is the teacher-facing assistant name. Its whole-lesson engine is
# DeepSeek; the optional per-section enrichment modes can keep using Groq.
# Standard generation never needs a provider.
#
# Named providers (gemini kept for history, groq, deepseek, openai, ollama,
# opencode-zen, minimax) remain supported by the provider abstraction.
#
# The owner supplies GROQ_API_KEY here (never commit a real key).
# Recommended model: openai/gpt-oss-120b (supports strict Structured Outputs).
AI_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# DeepSeek — Zeli's engine. Server-side ONLY: never prefix with NEXT_PUBLIC_
# and never expose it to browser code. Leave empty in this example; the owner
# supplies the real value in the private backend environment.
DEEPSEEK_API_KEY=

# Whole-lesson "Generate with Zeli" method (independent of AI_MODE).
# Precedence for the key: ZELI_API_KEY (if set) > DEEPSEEK_API_KEY.
# When ZELI_PROVIDER=groq, the key fallback is GROQ_API_KEY instead.
# ZELI_ENABLED=false hides the method without affecting Standard generation.
# Every value below is optional; the defaults are shown explicitly so the
# operational contract is visible. Full table: docs/ZELI_ENVIRONMENT.md.
ZELI_ENABLED=true
ZELI_PROVIDER=deepseek
# One bounded fallback attempt for eligible provider failures only.
# Uses GROQ_MODEL/GROQ_BASE_URL/GROQ_API_KEY. Leave empty to disable.
ZELI_FALLBACK_PROVIDER=groq
ZELI_MODEL=deepseek-flash
ZELI_BASE_URL=https://api.deepseek.com
ZELI_API_KEY=
# 0.0–2.0; omitted automatically when thinking is enabled / model is a reasoner
ZELI_TEMPERATURE=0.3
# 1–8192; sent as the API's max_tokens (completion budget)
ZELI_MAX_TOKENS=2000
# enabled | disabled | auto (auto omits the thinking parameter)
ZELI_THINKING_MODE=disabled
# 1–60 seconds (HTTP connect timeout)
ZELI_CONNECT_TIMEOUT_SECONDS=10
# 1–600 seconds (HTTP read timeout)
ZELI_READ_TIMEOUT_SECONDS=90
# 0–5; transient failures only (429/5xx/network), exponential back-off
ZELI_MAX_RETRIES=2
# Historical alternative provider (not the production runtime):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MINIMAX_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenCode Zen — free models (nemotron-3-ultra-free, mimo-v2.5-free, etc.)
# Get API key at https://opencode.ai
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=nemotron-3-ultra-free
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# ── LOGGING ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── PAYSTACK SUBSCRIPTIONS ──────────────────────────────────────────────
# Test keys use pk_test_/sk_test_; live keys use pk_live_/sk_live_.
# PAYSTACK_MODE must match the key: "test" in development/tests, "live" in
# production. A live key is refused while PAYSTACK_MODE is not "live", so a
# development host cannot start a real-money payment.
# PAYSTACK_ENABLED=false disables new payment initiation safely.
# Do NOT set NEXT_PUBLIC_* to a secret key. The server-side Charge API does not
# need a public key.
PAYSTACK_ENABLED=true
PAYSTACK_MODE=test
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# ── REFERRAL PROGRAMME ───────────────────────────────────────────────────────
# Reward values and the per-term limit are stored in referral_settings and can
# be changed by a platform administrator at PUT /api/referrals/settings.
# Optional override for the start of the current academic term (ISO date).
# REFERRAL_TERM_START=2026-09-01
